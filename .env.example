# Website content database. NEVER commit .env (.gitignore has it). Values are never printed by ./site.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# Public key (safe for a browser); used only by the keep-alive on chicago-o
SUPABASE_PUBLISHABLE_KEY=

# Supabase "personal-site": Connect -> Session pooler (IPv4), user site_user.<ref>
SUPABASE_POOLER_URL=
# Direct connection (IPv6), fallback
SUPABASE_DB_URL=

# chicago-o (Tailscale only; use --via-ssh otherwise): postgresql://site_user:<password>@<tailscale-ip>:5432/site_db
CHICAGO_DB_URL=
