SUPABASE_POOLER_URL=
# Direct connection (IPv6), fallback
SUPABASE_DB_URL=

# chicago-o (Tailscale only): postgresql://site_user:<password>@chicago-o:5432/site_db
CHICAGO_DB_URL=
